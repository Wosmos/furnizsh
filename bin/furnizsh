#!/usr/bin/env bash
# ============================================================
#  furnizsh — the command
#  https://github.com/Wosmos/furnizsh
#
#  A thin dispatcher over the scripts. This is what gets put on
#  your PATH by Homebrew and npm, so `furnizsh install` works
#  the same whether you cloned the repo or installed a package.
#
#    furnizsh install [flags]     set everything up
#    furnizsh uninstall [flags]   remove it
#    furnizsh doctor              health-check the setup
#    furnizsh theme [name]        list themes, or switch
#    furnizsh version             what's installed, and what's latest
#    furnizsh help                this message
# ============================================================

set -euo pipefail

# ------------------------------------------------------------
# Find where the payload lives.
#
# Three cases, in order:
#   1. FURNIZSH_SHARE set explicitly (packagers, testing)
#   2. running from a git checkout — ../config exists next to bin/
#   3. installed by a package manager — look in the usual prefixes
# ------------------------------------------------------------
find_share() {
  if [ -n "${FURNIZSH_SHARE:-}" ] && [ -d "$FURNIZSH_SHARE/config" ]; then
    printf '%s' "$FURNIZSH_SHARE"
    return 0
  fi

  # Resolve this script through any symlinks (brew links into bin/).
  local src="${BASH_SOURCE[0]}" dir
  while [ -L "$src" ]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    case "$src" in /*) ;; *) src="$dir/$src" ;; esac
  done
  dir="$(cd -P "$(dirname "$src")" && pwd)"

  # Case 2: git checkout — bin/furnizsh, so the repo root is one up.
  if [ -d "$dir/../config" ]; then
    (cd "$dir/.." && pwd)
    return 0
  fi

  # Case 3: packaged. brew --prefix resolves both Intel and Apple Silicon.
  local prefix
  for prefix in \
    "$(brew --prefix 2>/dev/null || true)/share/furnizsh" \
    /usr/local/share/furnizsh \
    /opt/homebrew/share/furnizsh \
    "$HOME/.local/share/furnizsh"
  do
    [ -d "$prefix/config" ] && { printf '%s' "$prefix"; return 0; }
  done

  printf 'furnizsh: cannot find its files. Set FURNIZSH_SHARE to the install directory.\n' >&2
  return 1
}

SHARE="$(find_share)"
VERSION="$(cat "$SHARE/VERSION" 2>/dev/null || printf 'unknown')"

usage() {
  cat <<EOF
furnizsh $VERSION — a neon terminal, in one command

  furnizsh <command> [flags]

Commands:
  install      set up the terminal        (flags: furnizsh install --help)
  uninstall    remove it, restore backups
  doctor       health-check every part of the setup
  update       update to the latest release (--check to only look)
  theme [name] list themes, or switch to one
  version      show installed and latest version
  help         this message

Examples:
  furnizsh install --theme gruvbox --tools extended
  furnizsh install --dry-run
  furnizsh theme catppuccin
  furnizsh update --check
  furnizsh doctor

Docs: https://wosmos.github.io/furnizsh
EOF
}

cmd_version() {
  printf 'furnizsh %s\n' "$VERSION"
  printf '  files:     %s\n' "$SHARE"

  local installed="$HOME/.config/furnizsh/VERSION"
  if [ -f "$installed" ]; then
    printf '  installed: %s\n' "$(cat "$installed")"
  else
    printf '  installed: not installed — run `furnizsh install`\n'
  fi

  # Best-effort latest check; never fail the command over a network blip.
  if command -v curl >/dev/null 2>&1; then
    local latest
    latest="$(curl -fsS --max-time 4 \
      https://api.github.com/repos/Wosmos/furnizsh/releases/latest 2>/dev/null \
      | sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' | head -1)"
    if [ -n "${latest:-}" ]; then
      if [ "$latest" = "$VERSION" ]; then
        printf '  latest:    %s (up to date)\n' "$latest"
      else
        printf '  latest:    %s — https://github.com/Wosmos/furnizsh/releases\n' "$latest"
      fi
    fi
  fi
}

# `theme` is also a shell function once installed. This is the version that
# works before the shell config is loaded, or from a script — it rewrites the
# configs but obviously cannot reload your running prompt.
cmd_theme() {
  local themes_dir="$SHARE/config/themes"
  [ -d "$themes_dir" ] || { printf 'furnizsh: no themes at %s\n' "$themes_dir" >&2; exit 1; }

  if [ $# -eq 0 ]; then
    printf '\nThemes  (furnizsh theme <name> to switch)\n\n'
    local f id label
    for f in "$themes_dir"/*.theme; do
      [ -e "$f" ] || continue
      id="$(basename "$f" .theme)"
      label="$(sed -n 's/^THEME_LABEL="\(.*\)"/\1/p' "$f")"
      printf '  %-12s %s\n' "$id" "$label"
    done
    printf '\n'
    return 0
  fi

  # Re-running install with just the theme is the least surprising way to do
  # this: one code path, same backups, same validation.
  exec "$SHARE/install.sh" --theme "$1" --yes --no-font --no-chsh --no-claude
}

main() {
  local cmd="${1:-help}"
  [ $# -gt 0 ] && shift

  case "$cmd" in
    install)          exec "$SHARE/install.sh" "$@" ;;
    uninstall|remove) exec "$SHARE/uninstall.sh" "$@" ;;
    doctor|check)     exec "$SHARE/doctor.sh" "$@" ;;
    update|upgrade)   exec "$SHARE/update.sh" "$@" ;;
    theme)            cmd_theme "$@" ;;
    version|--version|-v) cmd_version ;;
    help|--help|-h)   usage ;;
    *)
      printf 'furnizsh: unknown command '\''%s'\''\n\n' "$cmd" >&2
      usage >&2
      exit 1
      ;;
  esac
}

main "$@"
